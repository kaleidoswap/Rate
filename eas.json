{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_CHANNEL": "beta" },
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_CHANNEL": "store" },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "644JA45Z2S"
      }
    }
  }
}
