{
  "expo": {
    "name": "KaleidoSwap",
    "slug": "kaleidoswap-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#102217"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kaleidoswap.wallet",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes for Bitcoin addresses and Lightning invoices.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock your wallet securely.",
        "NSMicrophoneUsageDescription": "Allow KaleidoSwap to use the microphone for on-device voice commands to the AI assistant.",
        "NSPhotoLibraryUsageDescription": "Allow KaleidoSwap to access your photo library to scan QR codes from saved images.",
        "NSPhotoLibraryAddUsageDescription": "Allow KaleidoSwap to save QR codes and receipts to your photo library.",
        "NSLocalNetworkUsageDescription": "KaleidoSwap uses the local network to download and sync the on-device AI models peer-to-peer.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kaleidoswap.wallet",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102217"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KaleidoSwap to access your camera to scan QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow KaleidoSwap to use Face ID for secure wallet access."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "backgroundModes": [
              "fetch",
              "processing"
            ]
          },
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      "@qvac/sdk/expo-plugin",
      "expo-background-task",
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "08866d02-27ca-4a1f-9c84-bebe240f7314"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/your-project-id-here"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
