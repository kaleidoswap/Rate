# App Store Connect API credentials for `pnpm testflight` (scripts/testflight.sh).
# Copy this file to `.env.testflight.local` (gitignored) and fill in real values.
#
# Generate the key at: App Store Connect > Users and Access > Integrations >
# App Store Connect API > generate (role: App Manager or Admin). You can only
# download the AuthKey_*.p8 once — keep it outside the repo (it is also *.p8
# gitignored as a safety net).

# Absolute path to the downloaded AuthKey_<KEYID>.p8
ASC_KEY_P8=/Users/you/.appstoreconnect/private_keys/AuthKey_ABC123XYZ.p8

# The Key ID (the XXXXXXXXXX in the AuthKey filename)
ASC_KEY_ID=ABC123XYZ

# The Issuer ID (UUID shown above the keys list)
ASC_ISSUER_ID=11111111-2222-3333-4444-555555555555

# Apple Developer Team ID (defaults to 644JA45Z2S if omitted)
TEAM_ID=644JA45Z2S
